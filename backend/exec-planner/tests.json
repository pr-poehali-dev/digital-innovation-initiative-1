{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unauthorized list",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized plan detail",
      "method": "GET",
      "path": "/?action=plan&plan_id=1",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized resource_load",
      "method": "GET",
      "path": "/?action=resource_load",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized save_plan blocked",
      "method": "POST",
      "path": "/?action=save_plan",
      "body": {"title": "test"},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized save_step blocked",
      "method": "POST",
      "path": "/?action=save_step",
      "body": {"plan_id": 1, "title": "test"},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized delete_step blocked",
      "method": "POST",
      "path": "/?action=delete_step",
      "body": {"id": 1},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    }
  ]
}
