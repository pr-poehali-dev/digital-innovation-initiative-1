{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unauthorized list",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized save_note blocked",
      "method": "POST",
      "path": "/?action=save_note",
      "body": {"title": "test"},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized upload blocked",
      "method": "POST",
      "path": "/?action=upload",
      "body": {"filename": "a.pdf", "file_data": "x"},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized delete blocked",
      "method": "POST",
      "path": "/?action=delete",
      "body": {"id": 1},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    }
  ]
}
