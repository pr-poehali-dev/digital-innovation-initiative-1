%% ЦЕЛЕВАЯ МОДЕЛЬ (проектное требование). Технически НЕ реализовано в коде на 2026-09-11.
%% Версия v2. См. лист "11.Аудит AI-маршрута" пакета — фактические права и фильтры отличаются от этой схемы.
stateDiagram-v2
    [*] --> НеУстановлено

    state "ПРОИСХОЖДЕНИЕ (неизменяемо после фиксации)" as Origin {
        НеУстановлено --> Первоисточник
        НеУстановлено --> ВведеноПользователем : требует подтверждённого события/автора
        НеУстановлено --> Импортировано
        НеУстановлено --> РаспознаноOCR
        НеУстановлено --> ИзвлеченоИИ
        НеУстановлено --> ПредложеноИИ
        note right of ПредложеноИИ
            Перехода в "введено пользователем" НЕТ.
            Принятие человеком = отдельные поля
            verified_by / approved_by, а не смена origin
        end note
    }

    state "ДОСТУПНОСТЬ ОРИГИНАЛА" as Avail {
        [*] --> НеПроверено2["не проверено"]
        НеПроверено2 --> Подтверждён["подтверждён (файл, хеш, метаданные сверены)"]
        НеПроверено2 --> НеНайден["не найден"]
        НеПроверено2 --> Недоступен["недоступен (нет прав/приватный CDN)"]
    }

    state "СТАТУС ИСТОЧНИКА ПО ПЕРВОИСТОЧНИКУ" as SrcStatus {
        [*] --> НеУстановленДок["не установлен"]
        НеУстановленДок --> Проект
        Проект --> НаСогласовании
        НаСогласовании --> Утверждён
        Утверждён --> ВведёнВДействие
        ВведёнВДействие --> УтратилСилу
    }

    state "ПРИМЕНИМОСТЬ" as Applic {
        [*] --> НеОпределена
        НеОпределена --> Применим
        НеОпределена --> ЧастичноПрименим
        НеОпределена --> НеПрименим
        НеОпределена --> ТребуетПроверки["требует проверки (не только юридической)"]
    }