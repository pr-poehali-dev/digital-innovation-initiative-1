    SOURCE_DOCUMENT {
        int id PK
        string source_type
        string original_title "неизменяемое"
        string display_title "может отличаться от original_title"
        string source_status "не установлен/проект/утверждён/действует/утратил силу"
        string processing_status "загружен/распознаётся/распознан/структурирован/ошибка"
        string applicability_status "не определён/применим/частично/не применим/треб.юр.проверки"
        bool original_linked "связан ли файл физически"
        string original_availability "подтверждён/не найден/недоступен/не проверен"
        string origin "первоисточник/введено польз./OCR/извлечено ИИ/предложено ИИ/не установлено"
        string verification_status
        string confidentiality_level
    }

    DOCUMENT_CHUNK {
        int id PK
        int document_revision_id FK
        int clause_id FK "nullable"
        int page_id FK "nullable"
        string locator_type "page/clause/legacy_text_offset"
        int legacy_chunk_index "nullable"
        int char_start "nullable"
        int char_end "nullable"
        text content
    }

    LEGACY_KNOWLEDGE_RECORD {
        int id PK
        string legacy_type "structured_work_artifact/legacy_note/legacy_ocr_representation"
        int migrated_to_source_document_id FK "nullable"
        bool is_legacy
        string migration_status
    }

    SOURCE_DOCUMENT ||--o| LEGACY_KNOWLEDGE_RECORD : "может происходить из legacy-записи"

    STAKEHOLDER_ENTITY ||--o{ LEGACY_KNOWLEDGE_RECORD : "структурные элементы матрицы №1 (будущее)"

